{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Portal": {
    "MetaConnectionString": "Server=host.docker.internal,1433;Database=DBLogReportPortal;User Id=portal_app;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True",
    "SourceHostOverride": "host.docker.internal",
    "Jwt": {
      "Issuer": "PortalLogReport",
      "Audience": "PortalLogReport",
      "SigningKey": "",
      "ExpireMinutes": 60
    },
    "Seed": {
      "Enabled": true,
      "DefaultPassword": "Portal@123",
      "AdminPassword": "Admin@123",
      "SourcePassword": "CHANGE_ME"
    },
    "Security": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "LoginRatePerMinute": 20
    },
    "Email": {
      "Mode": "Pickup",
      "From": "no-reply@portal.local",
      "FromName": "Portal Log Report",
      "PickupDirectory": "/app/mail",
      "LoginUrl": "http://localhost:8080",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "User": "",
        "Password": "",
        "UseSsl": true
      }
    }
  }
}
