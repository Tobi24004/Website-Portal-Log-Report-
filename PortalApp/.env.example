# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# cp .env.example .env

# Mật khẩu login portal_app (đọc/ghi metadata DB) — khớp CreateAppLogin.sql
PORTAL_APP_PASSWORD=change_me

# Mật khẩu login portal_readonly (chỉ đọc DB nguồn) — khớp CreateReadonlyLogin.sql
SOURCE_READONLY_PASSWORD=change_me

# Khóa ký JWT, >= 32 ký tự
JWT_SIGNING_KEY=change_me_use_a_long_random_key_at_least_32_chars

# Mật khẩu khởi tạo tài khoản demo
SEED_ADMIN_PASSWORD=Admin@123
SEED_DEFAULT_PASSWORD=Portal@123

# Email: Pickup (demo, ghi .eml) | Smtp | Disabled
EMAIL_MODE=Pickup
PORTAL_PUBLIC_URL=http://localhost:8080

# Cấu hình SMTP (chỉ cần khi EMAIL_MODE=Smtp). Với Gmail dùng App Password 16 ký tự.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USER="your_account@gmail.com"
SMTP_PASSWORD="your_gmail_app_password"
EMAIL_FROM="your_account@gmail.com"
